# Salin menjadi .env lalu isi. JANGAN commit .env.
SECRET_KEY=isi-string-acak-panjang
DEBUG=False
ALLOWED_HOSTS=hrms.contoh.org
CSRF_TRUSTED_ORIGINS=https://hrms.contoh.org
HTTPS=True

# sqlite (percobaan) atau mysql (produksi)
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Absensi QR: python -c "import secrets;print(secrets.token_urlsafe(48))"
ATTENDANCE_QR_SECRET=
ATTENDANCE_NETWORK_MODE=device

# Topbar (opsional; bila kosong dipakai data lembaga aktif di Admin > Custom > Institute)
SITE_NAME=Mata Dalan Institute
SITE_ADDRESS=
SITE_PHONE=
SITE_EMAIL=

# Health care: bonus tetap per sakit (US$) dan batas tahunan per pegawai (opsional)
HEALTH_BONUS=50
HEALTH_ANNUAL_LIMIT=
